  "differences": [
    "调查员原文误带“或者得知没有爪牙”的分支，适配当前官方“两人之一是指定爪牙”，不把图书管理员的零外来者分支混入。",
    "方古与红唇女郎的来源相克保留，并按当前官方“若会有两个恶魔且一个来自红唇女郎，则她仍是红唇女郎”表述。"
  ],
  "sourceMetaStates": [
    {
      "stateName": "醉酒与中毒",
      "stateDescription": "醉酒或中毒的玩家会失去能力，但会认为自己仍具有能力，说书人会做出这些玩家仍然具有能力的行为。如果醉酒或中毒玩家的角色能力会给他提供信息，说书人可能会给出错误信息。醉酒或中毒的玩家不会得知自己醉酒或中毒。"
    },
    {
      "stateName": "相克规则",
      "stateDescription": " 方古与红唇女郎：如果方古成功转化了外来者并因此死去，红唇女郎不会变成方古。"
    }
  ],
