    "author": "卡慕萝米",
    "description": "古堡疑云",
    "townsfolkName": "镇民",
    "outsidersName": "外来者",
    "minionsName": "爪牙",
    "demonsName": "恶魔",
    "townsfolk": "镇民",
    "outsider": "外来者",
    "minion": "爪牙",
    "demon": "恶魔",
    "a jinxedName": "相克",
    "a jinxed": "相克"
  },
  "authorRuleEntries": [
    {
      "id": "56786542_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/e/ed/Cannibal.png/300px-Cannibal.png",
      "name": "食人族&罂粟种植者",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果食人族获得了罂粟种植者的能力，当他获得下一个能力时，爪牙和恶魔也会互相认识。"
    },
    {
      "id": "4_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2d/Plaguedoctor.png/300px-Plaguedoctor.png",
      "name": "瘟疫医生&男爵",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果说书人获得了男爵的能力，至多两名玩家会变成不在场的外来者。"
    },
    {
      "id": "7_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2d/Plaguedoctor.png/300px-Plaguedoctor.png",
      "name": "瘟疫医生&提线木偶",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果在瘟疫医生死亡时说书人获得了提线木偶的能力，且与恶魔邻座的存活玩家中有镇民或外来者，其中一名玩家会变成邪恶的提线木偶。如果此时场上的邪恶玩家数量比初始设置时的数量超出一名或更多，改为无事发生。"
    },
    {
      "id": "31_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/3/3d/Marionette.png/300px-Marionette.png",
      "name": "提线木偶&气球驾驶员",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果提线木偶抽到了气球驾驶员，也可能会+1外来者"
    },
    {
      "id": "30_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/3/3d/Marionette.png/300px-Marionette.png",
      "name": "提线木偶&罂粟种植者",
      "team": "a jinxed",
      "setup": 0,
      "ability": "当罂粟种植者死亡后，恶魔会知道谁是提线木偶，但提线木偶什么都不会知道。"
    },
    {
      "id": "29_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/3/3d/Marionette.png/300px-Marionette.png",
      "name": "提线木偶&小怪宝",
      "team": "a jinxed",
      "setup": 0,
      "ability": "提线木偶会与一名爪牙玩家邻座，而不是恶魔。提线木偶不会被唤醒来决定是否照看小怪宝，也不会在照看小怪宝时得知自己是提线木偶。"
    },
    {
      "id": "44_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&炼金术士",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果炼金术士获得了召唤师的能力，游戏会以初始有恶魔在场进行。炼金术士召唤师选择的玩家会变成恶魔但不会改变阵营。"
    },
    {
      "id": "46_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&罂粟种植者",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果召唤师创造恶魔时罂粟种植者存活，由召唤师来选择创造哪种恶魔，由说书人来决定哪名玩家发生转变。"
    },
    {
      "id": "47_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&提线木偶",
      "team": "a jinxed",
      "setup": 0,
      "ability": "在初始设置时，提线木偶会与召唤师邻座。召唤师会得知谁是提线木偶。"
    },
    {
      "id": "109_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&卡扎力",
      "team": "a jinxed",
      "setup": 0,
      "ability": "召唤师无法创造已经在场的恶魔。如果召唤师创造了一个不在场的恶魔，当晚的死亡由说书人决定。"
    },
    {
      "id": "34_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/4/40/Baron.png/300px-Baron.png",
      "name": "男爵&异端分子",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果异端分子在剧本中，男爵的效果可能会只增加一个而非两个外来者。（全追慎用）"
    },
    {
      "id": "62_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/3/39/Lilmonsta.png/300px-Lilmonsta.png",
      "name": "小怪宝&魔术师",
      "team": "a jinxed",
      "setup": 0,
      "ability": "每个夜晚，由魔术师来选择一个爪牙角色：如果他和小怪宝均存活，由他来照看小怪宝。"
    },
    {
      "id": "61_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/3/39/Lilmonsta.png/300px-Lilmonsta.png",
      "name": "小怪宝&罂粟种植者",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果罂粟种植者在场，爪牙们不会同时醒来选择照看小怪宝。他们会依次单独被唤醒，直到其中一人选择照看小怪宝。"
    },
    {
      "id": "112312312312312122333_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/1/18/Lordoftyphon.png",
      "name": "堤丰之首&召唤师",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家变成一个不在场的邪恶爪牙。"
    },
    {
      "id": "106_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/4/46/Kazali.png/300px-Kazali.png",
      "name": "卡扎力&提线木偶",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果卡扎力选择创造提线木偶，他只能选择将自己的邻座玩家变成提线木偶。"
    },
    {
      "id": "104_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/4/46/Kazali.png/300px-Kazali.png",
      "name": "卡扎力&赏金猎人",
      "team": "a jinxed",
      "setup": 0,
      "ability": "在卡扎力行动完毕后，如果赏金猎人仍然在场，才会创造邪恶镇民。"
    }
  ],
