  "authorRuleEntries": [
    {
      "id": "3_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&祖母",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果暴乱提名并杀死了孙子，祖母会一同死亡。 "
    },
    {
      "id": "1_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&驱魔人",
      "team": "a jinxed",
      "setup": 0,
      "ability": "互为克星的角色在同一时间里只能有其中一个角色在场。"
    },
    {
      "id": "4_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&报丧女妖",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果暴乱提名并杀死了报丧女妖，所有玩家都会得知报丧女妖死亡，随后报丧女妖可以立即提名两名玩家。（同时或按顺序结算这两条提名链。）"
    },
    {
      "id": "2_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&落难少女",
      "team": "a jinxed",
      "setup": 0,
      "ability": "暴乱被落难少女当作爪牙。  "
    },
    {
      "id": "6_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&帽匠",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果帽匠死亡时暴乱在场，一名暴乱选择变成其他恶魔，则其他所有暴乱需要选择变成其他爪牙。如果帽匠死亡时恶魔选择变成暴乱，所有爪牙会一同变成暴乱（如果发生在第三天后，则游戏会多进行一天）。"
    },
    {
      "id": "5_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱&麻脸巫婆",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果麻脸巫婆创造了暴乱，所有邪恶玩家都会变成暴乱。如果麻脸巫婆在游戏的第三天之后创造了暴乱，则游戏还会再进行一天。"
    },
    {
      "id": "7_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/c/c0/Riot.png/300px-Riot.png",
      "name": "暴乱与召唤师",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果召唤师创造了暴乱，被选择的玩家和所有邪恶玩家都变成邪恶的暴乱。被选择的玩家必须是与召唤师邻近的存活善良玩家。"
    },
    {
      "id": "8_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&炼金术士",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果炼金术士获得了召唤师的能力，游戏会以初始有恶魔在场进行。炼金术士召唤师选择的玩家会变成恶魔但不会改变阵营。"
    },
    {
      "id": "48.1_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&帽匠",
      "team": "a jinxed",
      "setup": 0,
      "ability": "召唤师无法创造已经在场的恶魔。如果召唤师创造了一个不在场的恶魔，当晚的死亡由说书人决定。"
    },
    {
      "id": "9_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/2/2f/Summoner.png/300px-Summoner.png",
      "name": "召唤师&麻脸巫婆",
      "team": "a jinxed",
      "setup": 0,
      "ability": "召唤师无法创造已经在场的恶魔。如果召唤师创造了一名不在场的恶魔，当晚的死亡由说书人决定。"
    },
    {
      "id": "114_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/d/de/Pithag.png/300px-Pithag.png",
      "name": "麻脸巫婆&莽夫",
      "team": "a jinxed",
      "setup": 0,
      "ability": "被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。"
    },
    {
      "id": "11_meta",
      "image": "https://clocktower-wiki.gstonegames.com/images/thumb/d/de/Pithag.png/300px-Pithag.png",
      "name": "麻脸巫婆与落难少女",
      "team": "a jinxed",
      "setup": 0,
      "ability": "如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。"
    }
  ],
