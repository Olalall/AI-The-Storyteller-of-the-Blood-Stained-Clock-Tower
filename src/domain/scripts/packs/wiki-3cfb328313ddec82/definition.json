      ],
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "magician-legion-jinx",
      "roleId": "magician",
      "summary": "If the Magician is in play, during the Demon info step, Legion wake in separate groups. Each group learns which players are good, but does not learn the Magician.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/jinxes.json"
      ],
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "magician-marionette-jinx",
      "roleId": "magician",
      "summary": "If the Magician is alive, the Demon doesn't know which neighbor is the Marionette.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/jinxes.json"
      ],
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "marionette-huntsman-jinx",
      "roleId": "marionette",
      "summary": "If the Marionette thinks that they are the Huntsman, the Damsel was added during setup.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/jinxes.json"
      ],
      "reviewedAt": "2026-10-21"
    },
    {
      "id": "pithag-damsel-jinx",
      "roleId": "pithag",
      "summary": "If a Pit-Hag creates a Damsel, the Storyteller chooses which player it is.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/jinxes.json"
