  "setupRules": [
    {
      "id": "legion-majority",
      "roleId": "legion",
      "summary": "军团局多数玩家实际为军团，军团也登记为爪牙；模板显式记录多恶魔、零实际爪牙及善良人数。只有邪恶玩家投票时处决失败；不是自动禁止记录那一轮投票。 本批选用官方允许的三枚伪装方案，不支持在这些模板中临时改成零枚；零伪装由主持在后续专门支持后再选。",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://kkovo550.github.io/clocktower-wiki/script_lib/%E5%89%A7%E6%9C%AC%E5%BA%93.html",
        "https://release.botc.app/resources/data/roles.json",
        "https://wiki.bloodontheclocktower.com/Legion"
      ],
      "reviewedAt": "2026-10-16"
    },
    {
      "id": "fanggu-outsider",
      "roleId": "fanggu",
      "summary": "Fang Gu: setup adds 1 Outsider.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/roles.json"
      ],
      "reviewedAt": "2026-07-19"
    },
    {
      "id": "heretic-lleech-jinx",
      "roleId": "heretic",
      "summary": "Only 1 jinxed character can be in play.",
      "knowledgeStatus": "confirmed",
      "sourceUrls": [
        "https://release.botc.app/resources/data/jinxes.json"
      ],
      "reviewedAt": "2026-10-21"
    },
    {
