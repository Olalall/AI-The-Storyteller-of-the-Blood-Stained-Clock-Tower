# Local backend
BOTC_BACKEND_HOST=127.0.0.1
BOTC_BACKEND_PORT=8787
BOTC_STATIC_DIR=dist
BOTC_ARCHIVE_DATA_FILE=data/archives/archives.json

# AI provider
# Keep disabled by default. Put real keys only in your local environment or server secret store.
BOTC_AI_ENABLED=false
BOTC_AI_PROVIDER=openai-compatible
BOTC_AI_BASE_URL=https://api.example.com/v1
BOTC_AI_MODEL=your-model-name
BOTC_AI_API_KEY=replace-with-your-local-secret
BOTC_AI_TIMEOUT_MS=30000
BOTC_AI_MAX_CONTEXT_TOKENS=12000

# Optional VPS sync script variables
BOTC_ASSISTANT_DEPLOY_HOST=
BOTC_ASSISTANT_DEPLOY_USER=Administrator
BOTC_ASSISTANT_SSH_PORT=22
BOTC_ASSISTANT_REMOTE_DIR=C:\botc-storyteller-companion
BOTC_ASSISTANT_STAGING_DIR=C:\botc-storyteller-companion-deploy
BOTC_ASSISTANT_BACKEND_PORT=3000
